# Configuración de Supabase
# Copia este archivo como .env y completa con tus credenciales reales

# URL de tu proyecto Supabase
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima de tu proyecto Supabase
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de servicio (solo para operaciones del servidor - opcional)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Variables adicionales (opcional)
# PUBLIC_SITE_URL=http://localhost:4321
# PUBLIC_REDIRECT_URL=http://localhost:4321/dashboard
