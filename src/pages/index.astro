---
import Layout from '../layouts/Layout.astro';
import { LoginForm, ProtectedRoute } from '../components';
---

<Layout title="8Financial - Iniciar Sesión">
	<main class="min-h-screen bg-gradient-to-br from-indigo-50 via-blue-50 to-cyan-50 flex items-center justify-center p-4">
		<ProtectedRoute client:load requireAuth={false}>
			<div class="w-full max-w-md">
				<!-- Header con animación -->
				<div class="text-center mb-8 animate-fade-in">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full mb-4 shadow-lg">
						<span class="text-2xl font-bold text-white">8F</span>
					</div>
					<h1 class="text-4xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 bg-clip-text text-transparent mb-2">
						8Financial
					</h1>
					<p class="text-gray-600 text-lg">
						Gestiona tus finanzas ( o al menos intentalo)
					</p>
				</div>
				<LoginForm client:load />
			</div>
		</ProtectedRoute>
	</main>
</Layout>

<style>
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(-20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 0.6s ease-out;
	}
</style>
